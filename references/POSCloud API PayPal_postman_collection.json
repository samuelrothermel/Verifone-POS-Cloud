    "type": "basic",
    "basic": [
      {
        "key": "password",
        "value": "{{user_API}}",
        "type": "string"
      },
      {
        "key": "username",
        "value": "{{user_ID}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "exec": [
          "// Code to generate a 12 digit Random number for referenceId\r",
          "const min = 100000000000; // Minimum 12-digit number\r",
          "const max = 999999999999; // Maximum 12-digit number\r",
          "const referenceId = Math.floor(Math.random() * (max - min + 1) + min);\r",
          "\r",
          "// Set the generated number as an environment variable\r",
          "pm.environment.set('referenceId', referenceId.toString());\r",
          "\r",
          "// Get the current value of the running number from the environment\r",
          "let runningNumber = pm.environment.get(\"runningNumber\");\r",
          "\r",
          "\r",
          "// Code to generate the 6 digit running number for STAN\r",
          "// Check if the running number exists\r",
          "if (!runningNumber) {\r",
          "    runningNumber = \"100000\"; // Set the initial value for the running number\r",
          "}\r",
          "\r",
          "// Convert the running number to an integer and increment it by 1\r",
          "runningNumber = parseInt(runningNumber) + 1;\r",
          "\r",
          "// Store the updated running number back to the environment\r",
          "pm.environment.set(\"runningNumber\", runningNumber.toString());\r",
          "\r",
          "// Set the six-digit running number as a request variable\r",
          "pm.variables.set(\"sixDigitNumber\", runningNumber.toString().padStart(6, \"0\"));\r",
          "\r",
          "pm.globals.set(\"sixDigitNumberSaved\", runningNumber.toString().padStart(6, \"0\"));\r",
          "pm.globals.set(\"runningNumberSaved\", runningNumber.toString());"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "exec": [
          ""
        ]
      }
    }
  ]
