        {
          "listen": "test",
          "script": {
            "exec": [
              "let response = pm.response.json()\r",
              "let saleData = response.TransactionStatusResponse.RepeatedMessageResponse.RepeatedResponseMessageBody.PaymentResponse.SaleData.SaleToPOIData\r",
